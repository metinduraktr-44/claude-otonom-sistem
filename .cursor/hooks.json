{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "python3 scripts/secret_scan.py --hook",
        "description": "Düzenlenen dosyada secret pattern tarar; uyarı + log (değer yazmaz)"
      },
      {
        "command": "python3 scripts/ethics_check.py --hook",
        "description": "Offensive/exploit içerik pattern denetimi"
      },
      {
        "command": "python3 scripts/qa_check.py",
        "description": "LATOS: title inventory diff + char target skeleton check"
      },
      {
        "command": "python3 scripts/citation_check.py",
        "description": "LATOS: EXPERTS/FORECASTS URL+timestamp kontrolü"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard.sh",
        "description": "Tehlikeli shell reddet; git kurtarma izinli (failClosed)",
        "matcher": "rm -rf|push --force|curl.*\\|.*sh",
        "failClosed": true,
        "timeout": 10
      },
      {
        "command": ".cursor/hooks/block-dangerous.sh",
        "description": "Ek tehlikeli kalıp koruması (legacy)"
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/redact-secrets.sh",
        "description": "Okuma öncesi secret uyarı/redakt notu"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/phase-audit.sh",
        "description": "Oturum bitişinde Security OS + LATOS faz/audit damgası"
      }
    ]
  }
}
